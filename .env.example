# Copiar a .env y reemplazar TODOS los valores marcados con CAMBIAR.
# El backend no arranca si falta alguna variable o si es inválida (fail fast).

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL. Con el backend en tu máquina usa 127.0.0.1 (no "localhost": en Windows
# intenta IPv6 primero y la conexión se demora). Los
# servicios de docker-compose usan el host interno "db".
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=depression_risk
POSTGRES_USER=depression_risk
POSTGRES_PASSWORD=CAMBIAR_min_12_caracteres

# JWT. Generar el secreto con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CAMBIAR_secreto_de_al_menos_32_caracteres
JWT_ISSUER=depression-risk-api
JWT_AUDIENCE=depression-risk-web
JWT_EXPIRE_MINUTES=60

# Administrador inicial (se crea con el script de seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIAR_min_12_caracteres

# Orígenes permitidos por CORS (lista JSON)
CORS_ORIGINS=["http://localhost:5173"]

# Modelos y datasets subidos (ruta relativa a backend/; en Docker se usa /app/artifacts)
ARTIFACTS_DIRECTORY=../artifacts
MAX_UPLOAD_MEGABYTES=10
TRAINING_TIMEOUT_SECONDS=900
