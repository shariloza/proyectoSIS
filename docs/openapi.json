{
  "openapi": "3.1.0",
  "info": {
    "title": "API de riesgo de depresión estudiantil",
    "description": "\nAPI del sistema de **estimación del riesgo de depresión en estudiantes**\n(trabajo final TALLERSISIA).\n\n> ⚠️ El resultado es una estimación estadística con fines académicos. **No es un diagnóstico.**\n\n* **Público:** predicción, métricas del modelo activo y health.\n* **Administración (JWT Bearer):** historial, datasets, re-entrenamiento, activación y rollback.\n\nTodos los errores usan el formato `{\"error\": {\"code\", \"message\", \"details\", \"request_id\"}}`.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/predictions": {
      "post": {
        "tags": [
          "Predicciones"
        ],
        "summary": "Estimar el riesgo de depresión",
        "description": "Usa únicamente el modelo ACTIVO. Guarda en el historial la entrada, el resultado, la probabilidad, la versión del modelo y la fecha. Límite: 30 solicitudes/min por IP.",
        "operationId": "predict_api_v1_predictions_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentProfileIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionOut"
                }
              }
            }
          },
          "422": {
            "description": "Datos de entrada inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas solicitudes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Servicio no disponible (sin modelo activo o base de datos caída)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Predicciones"
        ],
        "summary": "Historial de predicciones (admin)",
        "description": "Paginado, del más reciente al más antiguo. Restringido: son datos de salud mental.",
        "operationId": "history_api_v1_predictions_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Size"
            }
          },
          {
            "name": "model_version_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Model Version Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionPage"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado o token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Sin permisos de administrador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Datos de entrada inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
